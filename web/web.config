<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Flutter's entry points must be revalidated after every deployment. -->
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>

  <!-- Fonts and bundled assets change infrequently. Avoid a round trip to
       IIS for each one on every visit. Keep the lifetime short enough that
       an existing tab can pick up a release without holding old assets for
       days. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="canvaskit">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="icons">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
